{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "strict": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["vite.config.ts", "vite-plugin-ai-proxy.ts"]
}
